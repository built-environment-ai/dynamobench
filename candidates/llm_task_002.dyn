  },
  "Inputs": [],
  "Outputs": [],
  "Nodes": [
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\nimport json\r\nimport os\r\nimport time\r\n\r\nfrom Autodesk.Revit.DB import (\r\n    FilteredElementCollector,\r\n    BuiltInCategory,\r\n    BuiltInParameter,\r\n    SpatialElementBoundaryLocation,\r\n    Transaction\r\n)\r\n\r\n# ---------------------------------------------------------\r\n# CONFIGURATION\r\n# ---------------------------------------------------------\r\n\r\nAREA_THRESHOLD_M2 = 20.0\r\n\r\nLARGE_CLASSIFICATION = \"TZ_LARGE_LIVING\"\r\nCOMPACT_CLASSIFICATION = \"TZ_COMPACT_CELL\"\r\n\r\nTELEMETRY_PATH = (\r\n    r\"C:\\Users\\e-hbe\\dynamobench_v1\\reports\"\r\n    r\"\\candidate_llm_t002_exec.json\"\r\n)\r\n\r\n# ---------------------------------------------------------\r\n# DYNAMO / REVIT CONTEXT\r\n# ---------------------------------------------------------\r\n\r\nclr.AddReference(\"RevitServices\")\r\n\r\nfrom RevitServices.Persistence import DocumentManager\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\n# ---------------------------------------------------------\r\n# INITIALIZE TELEMETRY\r\n# ---------------------------------------------------------\r\n\r\nstart_time = time.perf_counter()\r\n\r\nupdated_count = 0\r\nwarnings = []\r\nerrors = []\r\n\r\nexecution_passed = False\r\n\r\n# ---------------------------------------------------------\r\n# MAIN EXECUTION\r\n# ---------------------------------------------------------\r\n\r\ntry:\r\n\r\n    # Collect all Room elements in the active document.\r\n    rooms = (\r\n        FilteredElementCollector(doc)\r\n        .OfCategory(BuiltInCategory.OST_Rooms)\r\n        .WhereElementIsNotElementType()\r\n        .ToElements()\r\n    )\r\n\r\n    # Prepare eligible rooms before opening the transaction.\r\n    eligible_rooms = []\r\n\r\n    for room in rooms:\r\n\r\n        try:\r\n\r\n            # Exclude unplaced rooms.\r\n            if room.Location is None:\r\n                continue\r\n\r\n            # Exclude rooms without a valid enclosing boundary.\r\n            if room.Area <= 0:\r\n                continue\r\n\r\n            # Convert Revit internal square feet to square meters.\r\n            area_m2 = room.Area * 0.09290304\r\n\r\n            # Determine classification.\r\n            if area_m2 >= AREA_THRESHOLD_M2:\r\n                classification = LARGE_CLASSIFICATION\r\n            else:\r\n                classification = COMPACT_CLASSIFICATION\r\n\r\n            eligible_rooms.append((room, classification))\r\n\r\n        except Exception as room_error:\r\n\r\n            warnings.append(\r\n                \"Room ID {} skipped: {}\".format(\r\n                    room.Id.Value,\r\n                    str(room_error)\r\n                )\r\n            )\r\n\r\n    # -----------------------------------------------------\r\n    # WRITE PARAMETERS INSIDE A REVIT TRANSACTION\r\n    # -----------------------------------------------------\r\n\r\n    transaction = Transaction(\r\n        doc,\r\n        \"Classify Rooms by Floor Area\"\r\n    )\r\n\r\n    transaction.Start()\r\n\r\n    try:\r\n\r\n        for room, classification in eligible_rooms:\r\n\r\n            parameter = room.get_Parameter(\r\n                BuiltInParameter.ROOM_DEPARTMENT\r\n            )\r\n\r\n            if parameter is None:\r\n                warnings.append(\r\n                    \"Room ID {}: Department parameter unavailable.\".format(\r\n                        room.Id.Value\r\n                    )\r\n                )\r\n                continue\r\n\r\n            if parameter.IsReadOnly:\r\n                warnings.append(\r\n                    \"Room ID {}: Department parameter is read-only.\".format(\r\n                        room.Id.Value\r\n                    )\r\n                )\r\n                continue\r\n\r\n            if parameter.Set(classification):\r\n                updated_count += 1\r\n            else:\r\n                warnings.append(\r\n                    \"Room ID {}: Department parameter was not updated.\".format(\r\n                        room.Id.Value\r\n                    )\r\n                )\r\n\r\n        transaction.Commit()\r\n\r\n    except Exception:\r\n        if transaction.HasStarted():\r\n            transaction.RollBack()\r\n        raise\r\n\r\n    execution_passed = True\r\n\r\nexcept Exception as main_error:\r\n\r\n    errors.append(str(main_error))\r\n    execution_passed = False\r\n\r\n# ---------------------------------------------------------\r\n# EXECUTION TIME\r\n# ---------------------------------------------------------\r\n\r\nduration_ms = (time.perf_counter() - start_time) * 1000.0\r\n\r\n# ---------------------------------------------------------\r\n# JSON TELEMETRY\r\n# ---------------------------------------------------------\r\n\r\ntelemetry = {\r\n    \"execution\": {\r\n        \"execution_passed\": execution_passed,\r\n        \"node_error_count\": len(errors),\r\n        \"node_warning_count\": len(warnings),\r\n        \"duration_ms\": float(duration_ms),\r\n        \"warnings\": warnings,\r\n        \"errors\": errors\r\n    }\r\n}\r\n\r\ntry:\r\n\r\n    report_directory = os.path.dirname(TELEMETRY_PATH)\r\n\r\n    if not os.path.exists(report_directory):\r\n        os.makedirs(report_directory)\r\n\r\n    with open(TELEMETRY_PATH, \"w\") as telemetry_file:\r\n        json.dump(\r\n            telemetry,\r\n            telemetry_file,\r\n            indent=4\r\n        )\r\n\r\nexcept Exception as telemetry_error:\r\n\r\n    execution_passed = False\r\n    errors.append(\r\n        \"Telemetry file write failed: {}\".format(\r\n            str(telemetry_error)\r\n        )\r\n    )\r\n\r\n# ---------------------------------------------------------\r\n# DYNAMO OUTPUT\r\n# ---------------------------------------------------------\r\n\r\nOUT = (\r\n    \"Execution passed: {} | Rooms updated: {} | \"\r\n    \"Warnings: {} | Errors: {} | Duration: {:.2f} ms\"\r\n).format(\r\n    execution_passed,\r\n    updated_count,\r\n    len(warnings),\r\n    len(errors),\r\n    duration_ms\r\n)",
      "Engine": "PythonNet3",
      "VariableInputPorts": true,
